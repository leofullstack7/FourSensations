{
  "name": "ginnabeauty-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:clean": "node scripts/clean-next.mjs && next dev",
    "dev:turbo": "next dev --turbo",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "dotenv -e .env -e .env.local -- prisma generate",
    "db:push": "dotenv -e .env -e .env.local -- prisma db push",
    "db:studio": "dotenv -e .env -e .env.local -- prisma studio",
    "db:seed": "dotenv -e .env -e .env.local -- prisma db seed",
    "migrate:proaging": "dotenv -e .env -e .env.local -- tsx scripts/migrate-proaging.ts",
    "migrate:cuidado-facial": "dotenv -e .env -e .env.local -- tsx scripts/migrate-cuidado-facial.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.7.4",
    "@prisma/client": "^6.3.1",
    "adm-zip": "^0.5.16",
    "bcryptjs": "^2.4.3",
    "dotenv": "^17.3.1",
    "framer-motion": "^11.18.2",
    "next": "14.2.15",
    "next-auth": "^5.0.0-beta.25",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resend": "^6.12.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.17.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "dotenv-cli": "^8.0.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.15",
    "prisma": "^6.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}

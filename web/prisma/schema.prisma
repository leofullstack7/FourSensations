generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  CUSTOMER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          UserRole  @default(CUSTOMER)
  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Product {
  id            String         @id @default(cuid())
  slug          String         @unique
  name          String
  brand         String         @default("GinnaBeauty")
  category      String
  subcategory   String
  description   String         @db.Text
  price         Int
  originalPrice Int?
  stock         Int            @default(0)
  rating        Float          @default(5)
  reviews       Int            @default(0)
  badge         String?
  emoji         String?
  /// URL pública (CDN) de la imagen principal.
  imageUrl      String?
  /// Código de referencia / variante (CSV, match con imágenes).
  externalRef   String?        @unique
  /// Etiquetas comerciales del producto (ej. "Base", "Sombras", "Gloss").
  tags          String[]       @default([])
  isNew         Boolean        @default(false)
  /// Prioridad en la grilla "Productos Destacados" del home (sin badge público).
  featuredInHome Boolean       @default(false)
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  images        ProductImage[]
}

enum BulkImportStatus {
  PREVIEW
  IMPORTING
  COMPLETED
  FAILED
}

/// Sesión de importación masiva CSV+ZIP (preview y commit).
model BulkImportJob {
  id                 String           @id @default(cuid())
  createdAt          DateTime         @default(now())
  expiresAt          DateTime
  status             BulkImportStatus @default(PREVIEW)
  /// Header original de la columna de código elegida.
  selectedCodeHeader String
  codeColumnIndex    Int
  csvDelimiter       String           @default(",")
  headers            Json
  /// Filas: { values: string[] } alineadas a headers.
  rows               Json
  /// Resultado enriquecido para UI + commit.
  previewPayload     Json
  stats              Json
  zipBlob            Bytes
  errorMessage       String?

  @@index([expiresAt])
  @@index([status])
}

/// Imágenes adicionales (galería). La principal sigue en `Product.imageUrl`.
model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId])
}

model Sale {
  id          String   @id @default(cuid())
  productId   String?
  productName String
  client      String?
  channel     String
  qty         Int
  total       Int
  status      String
  notes       String?
  createdAt   DateTime @default(now())
}

model SiteMenu {
  id        String   @id @default(cuid())
  data      Json
  updatedAt DateTime @updatedAt
}

/// Categorías de tienda (slug alineado con `Product.category`).
model Category {
  id            String        @id @default(cuid())
  slug          String        @unique
  name          String
  icon          String?
  sortOrder     Int           @default(0)
  subcategories Subcategory[]
}

model Subcategory {
  id         String   @id @default(cuid())
  slug       String
  name       String
  sortOrder  Int      @default(0)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, slug])
}

/// Configuración de contenido público (hero, textos, etc.) — fila singleton `id = 1`.
model SiteSettings {
  id        Int      @id @default(1)
  data      Json
  updatedAt DateTime @updatedAt
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  CUSTOMER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          UserRole  @default(CUSTOMER)
  accounts      Account[]
  sessions      Session[]
  orders        Order[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Product {
  id            String         @id @default(cuid())
  slug          String         @unique
  name          String
  brand         String         @default("GinnaBeauty")
  category      String
  subcategory   String
  description   String         @db.Text
  price         Int
  originalPrice Int?
  stock         Int            @default(0)
  rating        Float          @default(5)
  reviews       Int            @default(0)
  badge         String?
  emoji         String?
  /// URL pública (CDN) de la imagen principal.
  imageUrl      String?
  /// Código de referencia / variante (CSV, match con imágenes).
  externalRef   String?        @unique
  /// Etiquetas comerciales del producto (ej. "Base", "Sombras", "Gloss").
  tags          String[]       @default([])
  isNew         Boolean        @default(false)
  /// Prioridad en la grilla "Productos Destacados" del home (sin badge público).
  featuredInHome Boolean       @default(false)
  /// Catálogo Tintes: familia (relación maestra).
  tintFamilyId   String?
  tintFamily     TintFamily?    @relation(fields: [tintFamilyId], references: [id])
  /// Catálogo Tintes: tipo/línea (relación maestra).
  tintTypeId     String?
  tintType       TintType?      @relation(fields: [tintTypeId], references: [id])
  /// Código de nivel de color (ej. 9,5-1) — texto libre, importación Tintes.
  tintLevel      String?
  /// Grupo de color dentro de la línea — texto libre, importación Tintes.
  tintGroup      String?
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  images        ProductImage[]
  comboItems    ProductComboItem[]
}

/// Familia de tinte (catálogo maestro para importación Tintes).
model TintFamily {
  id        String    @id @default(cuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  products  Product[]
}

/// Tipo / línea de tinte (catálogo maestro para importación Tintes).
model TintType {
  id        String    @id @default(cuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  products  Product[]
}

/// Combo promocional creado en el panel (no altera el catálogo público hasta integración explícita).
model ProductCombo {
  id         String             @id @default(cuid())
  name       String
  slug       String             @unique
  /// Precio de venta del combo (COP, misma unidad que `Product.price`).
  comboPrice Int
  active     Boolean            @default(true)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  items      ProductComboItem[]

  @@index([createdAt])
}

model ProductComboItem {
  id        String       @id @default(cuid())
  comboId   String
  combo     ProductCombo @relation(fields: [comboId], references: [id], onDelete: Cascade)
  productId String
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int          @default(1)
  sortOrder Int          @default(0)

  @@index([comboId])
  @@index([productId])
}

enum BulkImportStatus {
  PREVIEW
  IMPORTING
  COMPLETED
  FAILED
}

/// Sesión de importación masiva CSV+ZIP (preview y commit).
model BulkImportJob {
  id                 String           @id @default(cuid())
  createdAt          DateTime         @default(now())
  expiresAt          DateTime
  status             BulkImportStatus @default(PREVIEW)
  /// Header original de la columna de código elegida.
  selectedCodeHeader String
  codeColumnIndex    Int
  csvDelimiter       String           @default(",")
  headers            Json
  /// Filas: { values: string[] } alineadas a headers.
  rows               Json
  /// Resultado enriquecido para UI + commit.
  previewPayload     Json
  stats              Json
  zipBlob            Bytes
  errorMessage       String?

  @@index([expiresAt])
  @@index([status])
}

/// Imágenes adicionales (galería). La principal sigue en `Product.imageUrl`.
model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId])
}

model Sale {
  id          String   @id @default(cuid())
  productId   String?
  productName String
  client      String?
  channel     String
  qty         Int
  total       Int
  status      String
  notes       String?
  createdAt   DateTime @default(now())
}

/// Estado del pedido en el flujo de compra (fulfillment).
enum OrderStatus {
  PENDING_PAYMENT
  PAID
  CANCELLED
  FAILED
}

/// Estado del cobro según proveedor (ePayco u otros).
enum PaymentStatus {
  PENDING
  PROCESSING
  APPROVED
  DECLINED
  EXPIRED
}

/// Pedido de tienda (checkout). La verdad del pago es `confirmationData` + `paymentStatus`, no la página de respuesta.
model Order {
  id                    String        @id @default(cuid())
  /// Referencia única (p. ej. enviada a ePayco como `invoice`).
  reference             String        @unique
  status                OrderStatus   @default(PENDING_PAYMENT)
  /// Identificador del proveedor: "EPAYCO", etc.
  paymentProvider       String?
  paymentStatus         PaymentStatus @default(PENDING)
  /// ID de transacción en el proveedor (p. ej. ref_payco / x_ref_payco).
  providerTransactionId String?       @unique
  /// Última sesión Smart Checkout (debug / correlación).
  epaycoSessionId       String?
  /// Payload enviado al crear sesión u onboarding Standard (sin secretos).
  providerPayload       Json?
  /// Parámetros de la URL de respuesta (no autoritativo; auditoría y UX).
  responseData          Json?
  /// Cuerpo del webhook de confirmación (fuente de verdad del pago).
  confirmationData      Json?
  /// Montos en COP (misma unidad que `Product.price`).
  subtotal              Int
  shipping              Int           @default(0)
  total                 Int
  currency              String        @default("COP")
  /// Datos de contacto y envío (estructura estable acordada con el checkout).
  customerEmail         String
  customerName          String
  customerPhone         String?
  shippingAddress       Json
  customerNote          String?
  userId                String?
  user                  User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  items                 OrderItem[]
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([userId])
  @@index([createdAt])
  @@index([paymentStatus])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  name        String
  imageUrl    String?
  unitPrice   Int
  quantity    Int
  lineTotal   Int

  @@index([orderId])
  @@index([productId])
}

model SiteMenu {
  id        String   @id @default(cuid())
  data      Json
  updatedAt DateTime @updatedAt
}

/// Categorías de tienda (slug alineado con `Product.category`).
model Category {
  id            String        @id @default(cuid())
  slug          String        @unique
  name          String
  icon          String?
  sortOrder     Int           @default(0)
  subcategories Subcategory[]
}

model Subcategory {
  id         String   @id @default(cuid())
  slug       String
  name       String
  /// Etiqueta de columna del mega menú (texto dorado): p. ej. Tratamiento, Rutina.
  menuTag    String?
  sortOrder  Int      @default(0)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, slug])
}

/// Configuración de contenido público (hero, textos, etc.) — fila singleton `id = 1`.
model SiteSettings {
  id        Int      @id @default(1)
  data      Json
  updatedAt DateTime @updatedAt
}

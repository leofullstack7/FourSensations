# PostgreSQL (Prisma)
# App / Prisma Client (pooled) — en Neon suele ser el host `-pooler` o `?pgbouncer=true`
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/ginnabeauty?schema=public"
# Conexión directa (sin pooler) — migraciones, db push, seed estable con Neon.
# En local sin pooler puedes copiar la misma URL que DATABASE_URL.
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/ginnabeauty?schema=public"

# Auth.js — URL pública de la app (Vercel / producción)
AUTH_SECRET="genera-un-secreto-largo-aleatorio"
AUTH_TRUST_HOST=true

# Google OAuth — login de clientes en la tienda (Consent screen + credenciales en Google Cloud Console)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Bunny Storage + Pull Zone (subida de imágenes de producto) — ver docs/BUNNY_IMAGES.md
# BUNNY_STORAGE_API_KEY="password-del-storage-zone-ftp-api"
# BUNNY_STORAGE_ZONE_NAME="nombre-de-tu-zona"
# BUNNY_STORAGE_REGION="ny"
# Opcional: hostname exacto del panel (si 401, úsalo en lugar de adivinar la región)
# BUNNY_STORAGE_API_HOST="br.storage.bunnycdn.com"
# BUNNY_CDN_BASE_URL="https://tu-pullzone.b-cdn.net"

# Seed (prisma db seed) — contraseña del usuario admin inicial
SEED_ADMIN_EMAIL="admin@ginnabeauty.local"
SEED_ADMIN_PASSWORD="CambiaEstaClave123!"

# ePayco (Apify + Smart Checkout) — llaves en panel → Configuración → Personalizaciones → Llaves secretas
EPAYCO_PUBLIC_KEY=""
EPAYCO_PRIVATE_KEY=""
EPAYCO_TEST="true"
# Base Apify (producción por defecto; sandbox si el panel indica otra)
EPAYCO_API_BASE_URL="https://apify.epayco.co"
# Opcional si ya defines NEXT_PUBLIC_SITE_URL: se usan /checkout/resultado y /api/payments/epayco/confirmation automáticamente
EPAYCO_RESPONSE_URL="https://ginnabeauty.com/checkout/resultado"
EPAYCO_CONFIRMATION_URL="https://ginnabeauty.com/api/payments/epayco/confirmation"
# Firma del webhook (distintas de PUBLIC_KEY/PRIVATE_KEY): panel ePayco — Customer ID y P_KEY
EPAYCO_CUSTOMER_ID=""
EPAYCO_P_KEY=""
EPAYCO_MERCHANT_NAME="GinnaBeauty"
# Opcional: GET de validación por ref_payco (respuesta del navegador)
EPAYCO_VALIDATION_BASE_URL="https://secure.epayco.co/validation/v1/reference"
# Obligatoria para URLs públicas de la tienda y, si no pones EPAYCO_RESPONSE_URL/CONFIRMATION_URL, para armar esas rutas.
NEXT_PUBLIC_SITE_URL="https://ginnabeauty.com"

# Bold (pasarela embebida) — firma en servidor; API key pública en cliente
BOLD_SECRET_KEY=""
NEXT_PUBLIC_BOLD_API_KEY=""
# WhatsApp (solo dígitos: 57 + celular Colombia sin +)
# NEXT_PUBLIC_WHATSAPP_NUMBER="573001234567"
